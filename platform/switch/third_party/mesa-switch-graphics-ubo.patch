+   uint64_t platform_flags = 0;
+#ifdef HAVE_SWITCH_PLATFORM
+   if (debug_get_bool_option("NVK_SWITCH_GRAPHICS_UBO_CBUF", false))
+      platform_flags |= UINT64_C(1) << 15;
+#endif
 
    assert(nak_flags <= UINT32_MAX);
    assert(nak_gpr_limit <= UINT8_MAX);
@@ -86,6 +91,7 @@
    return (no_cbufs ? 1 << 12 : 0)
       | (use_edb_buffer_views ? 1 << 13 : 0)
       | (instance->drirc.misc.ssbo_align_4b ? 1 << 14 : 0)
