@@ -461,9 +461,13 @@ build_cbuf_map(nir_shader *nir, struct lower_descriptors_ctx *ctx)
    }
 
 #ifdef HAVE_SWITCH_PLATFORM
-   /* Horizon skips the setup for fragment helper global loads. */
